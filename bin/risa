#!/usr/bin/env bash
# risa: the tool's one command. `risa backlog …` is the backlog (backlog/backlog.mjs);
# every other `risa …` is the orchestration command (loops/prd.sh). The repo it acts
# on is the one the current directory is in, as the machine config lists it.
set -euo pipefail
self=$(readlink -f "${BASH_SOURCE[0]}")
root=$(cd "$(dirname "$self")/.." && pwd)
# `risa --root`: the folder this command runs from, by the resolution above. A
# dispatcher run from a release asks it between ticks where `risa` now points.
if [[ ${1:-} == --root ]]; then
  echo "$root"
  exit 0
fi
if [[ ${1:-} == backlog ]]; then
  shift
  # prd.sh finds the repo through lib.sh; the backlog takes its config from
  # backlog_config (the main checkout's risa.json, unless RISA_CONFIG is a pin),
  # as lib.sh's backlog_run does for the loop scripts.
  # shellcheck source=../loops/backlog-config.sh
  source "$root/loops/backlog-config.sh"
  backlog_config "$root" || exit 2
  exec node "$root/backlog/backlog.mjs" "$@"
fi
# `risa init` and `risa config migrate` run on a repo no config loads for yet
# (loops/setup.mjs), so they go before prd.sh.
if [[ ${1:-} == init || ${1:-} == config ]]; then
  exec node "$root/loops/setup.mjs" "$@"
fi
exec bash "$root/loops/prd.sh" "$@"
