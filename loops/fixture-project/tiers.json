{
  "tiers": ["static", "unit", "integration", "components", "full", "candidate", "release"],
  "jobs": {
    "static": ["static"],
    "unit": ["unit-1", "unit-2"],
    "integration": ["integration"],
    "components": ["components-1", "components-2", "components-3"],
    "full": ["build"],
    "candidate": ["browser"],
    "release": ["browser-2", "browser-3", "zone-components-1", "zone-components-2", "zone-browser"]
  },
  "fileGroups": [
    {
      "group": "browser",
      "pattern": "e2e/*.spec.mjs",
      "tier": "candidate"
    },
    {
      "group": "browser-tooling",
      "pattern": "loops/browser.test.mjs",
      "tier": "integration"
    },
    {
      "group": "browser-tooling",
      "pattern": "tools/browser-run.test.mjs",
      "tier": "integration"
    },
    {
      "group": "integration",
      "pattern": "*.int.test.ts",
      "tier": "integration"
    },
    {
      "group": "components",
      "pattern": "*.browser.test.tsx",
      "tier": "components"
    },
    {
      "group": "unit",
      "pattern": "*",
      "tier": "unit"
    }
  ],
  "narrowedTiers": ["unit", "integration", "components"],
  "browserCheck": "e2e/*.spec.mjs",
  "narrowedFile": ".ci-narrowed.json",
  "forcedFlakeFile": ".github/ci-force-flake.json",
  "refPrefix": "ci/",
  "gates": {
    "quietLoadPerCore": 1,
    "measures": {
      "unit": {
        "aim": 300,
        "cutoff": 360,
        "armed": true
      },
      "components": {
        "aim": 300,
        "cutoff": 360,
        "armed": false
      },
      "quick": {
        "aim": 300,
        "cutoff": 360,
        "armed": false,
        "modes": ["quick", "slice"]
      }
    }
  }
}
