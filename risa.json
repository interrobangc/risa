{
  "name": "risa",
  "tool": {
    "prd": "risa",
    "backlog": "risa backlog",
    "self": true
  },
  "paths": {
    "backlog": "plans/backlog.md",
    "inbox": "plans/inbox.md",
    "archive": "plans/backlog-archive.md",
    "plans": "plans",
    "docs": "loops/docs",
    "agentsDoc": "AGENTS.md",
    "preferences": "docs/preferences.md",
    "tooling": ["bin"],
    "tierData": "risa-tiers.json",
    "checkPlanRules": "risa-check-plan.json"
  },
  "roles": {
    "planner": {
      "additions": "docs/planner.md"
    },
    "backlog": {
      "additions": "docs/backlog.md"
    }
  },
  "branches": {
    "trunk": "main",
    "prefixes": {
      "prd": "prd/",
      "slice": "slice/",
      "plan": "plan/",
      "hotfix": "hotfix/"
    }
  },
  "backlog": {
    "prdsHeading": "## PRDs",
    "idPrefix": "RISA",
    "formerIdPrefix": "B"
  },
  "commands": {
    "install": "pnpm install",
    "check": "pnpm check",
    "staticCheck": "pnpm format:check && pnpm lint && pnpm docs:budget",
    "testFile": "pnpm exec vitest run",
    "typecheck": "true",
    "typegen": "true",
    "toolingTests": "pnpm test",
    "log": "git log --oneline",
    "docBudget": "pnpm docs:budget",
    "format": "pnpm exec prettier --write",
    "datastoreStart": "true",
    "datastoreReset": "true",
    "datastoreSeed": "true"
  },
  "hooks": {
    "check": "sh -c 'pnpm check' --"
  },
  "testProjects": {
    "tooling": ["core:unit", "tooling:unit"],
    "browserHarness": "tooling:browser"
  }
}
