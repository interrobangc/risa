{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CARETOOK_CONTEXT_HOOK\" ] && node \"$CARETOOK_CONTEXT_HOOK\" hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CARETOOK_CONTEXT_HOOK\" ] && node \"$CARETOOK_CONTEXT_HOOK\" hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CARETOOK_CONTEXT_HOOK\" ] && node \"$CARETOOK_CONTEXT_HOOK\" hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CARETOOK_CONTEXT_HOOK\" ] && node \"$CARETOOK_CONTEXT_HOOK\" hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CARETOOK_CONTEXT_HOOK\" ] && node \"$CARETOOK_CONTEXT_HOOK\" hook 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "fastMode": false,
  "effortLevel": "low"
}
